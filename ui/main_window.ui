<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1400</width>
    <height>860</height>
   </rect>
  </property>
  <property name="minimumSize">
   <size>
    <width>1100</width>
    <height>680</height>
   </size>
  </property>
  <property name="windowTitle">
   <string>Margin Analyzer</string>
  </property>
  <property name="windowIcon">
   <iconset resource="resources.qrc">
    <normaloff>:/icons/app.svg</normaloff>:/icons/app.svg</iconset>
  </property>
  <property name="styleSheet">
   <string notr="true">/* ==================================================================
   Margin Analyzer - light theme
   background #F4F6FA   surface #FFFFFF    border #E3E8EF
   text #1F2937         secondary #64748B  muted #94A3B8
   accent #2563EB (hover #1D4ED8, pressed #1E40AF, soft #EFF4FF)

   Widgets are targeted by objectName (#name) or by the dynamic
   properties set in Designer: card, role, variant and state.
   ================================================================== */

/* ---- Base --------------------------------------------------------- */
QWidget {
    font-family: &quot;Segoe UI&quot;;
    font-size: 13px;
    color: #1F2937;
}
QMainWindow {
    background: #F4F6FA;
}

/* ---- Header ------------------------------------------------------- */
QFrame#headerBar {
    background: #FFFFFF;
    border: none;
    border-bottom: 1px solid #E3E8EF;
}
QLabel#appTitle {
    font-family: &quot;Segoe UI Semibold&quot;;
    font-size: 15px;
    color: #0F172A;
}
QLabel#breadcrumbSeparator {
    font-size: 18px;
    color: #CBD5E1;
}
QLabel#pageTitle {
    font-size: 15px;
    color: #64748B;
}

/* ---- Cards -------------------------------------------------------- */
QFrame[card=&quot;true&quot;] {
    background: #FFFFFF;
    border: 1px solid #E3E8EF;
    border-radius: 10px;
}
QFrame#tableHeader,
QFrame#logHeader {
    background: transparent;
    border: none;
}
QFrame#logHeader {
    border-bottom: 1px solid #EEF2F6;
}
QLabel#tableTitle,
QLabel#logTitle {
    font-family: &quot;Segoe UI Semibold&quot;;
    font-size: 14px;
    color: #0F172A;
}
QLabel#rowCountBadge {
    background: #EFF4FF;
    color: #1D4ED8;
    border-radius: 10px;
    padding: 2px 10px;
    font-family: &quot;Segoe UI Semibold&quot;;
    font-size: 12px;
}
QLabel#emptyStateLabel {
    color: #94A3B8;
    font-size: 14px;
}

/* ---- Labels ------------------------------------------------------- */
QLabel[role=&quot;fieldLabel&quot;] {
    font-family: &quot;Segoe UI Semibold&quot;;
    font-size: 12px;
    color: #64748B;
}
QLabel[role=&quot;hint&quot;] {
    color: #94A3B8;
}

/* ---- Inputs ------------------------------------------------------- */
QLineEdit,
QComboBox,
QDateEdit {
    background: #FFFFFF;
    border: 1px solid #D0D7E2;
    border-radius: 6px;
    padding: 0px 10px;
    min-height: 32px;
    selection-background-color: #BFD3FD;
    selection-color: #0F172A;
}
QLineEdit:hover,
QComboBox:hover,
QDateEdit:hover {
    border-color: #B8C2D1;
}
QLineEdit:focus,
QComboBox:focus,
QDateEdit:focus {
    border-color: #2563EB;
}
QLineEdit:disabled,
QComboBox:disabled,
QDateEdit:disabled {
    background: #F3F5F8;
    border-color: #E3E8EF;
    color: #9AA3AF;
}
QComboBox {
    combobox-popup: 0;
}
QComboBox::drop-down,
QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 28px;
    border: none;
    background: transparent;
}
QComboBox::down-arrow {
    image: url(:/icons/chevron-down.svg);
    width: 14px;
    height: 14px;
}
QComboBox::down-arrow:disabled {
    image: url(:/icons/chevron-down-disabled.svg);
}
QDateEdit::down-arrow {
    image: url(:/icons/calendar.svg);
    width: 16px;
    height: 16px;
}
QDateEdit::down-arrow:disabled {
    image: url(:/icons/calendar-disabled.svg);
}
QComboBox QAbstractItemView {
    background: #FFFFFF;
    border: 1px solid #E3E8EF;
    padding: 4px;
    outline: 0px;
}
QComboBox QAbstractItemView::item {
    min-height: 30px;
    padding: 0px 8px;
    border-radius: 4px;
}
QComboBox QAbstractItemView::item:hover {
    background: #F1F5F9;
    color: #1F2937;
}
QComboBox QAbstractItemView::item:selected {
    background: #EFF4FF;
    color: #1D4ED8;
}

/* ---- Buttons ------------------------------------------------------ */
QPushButton {
    background: #FFFFFF;
    border: 1px solid #D0D7E2;
    border-radius: 6px;
    padding: 0px 14px;
    min-height: 32px;
    font-family: &quot;Segoe UI Semibold&quot;;
    color: #1F2937;
}
QPushButton:hover {
    background: #F5F7FB;
    border-color: #B8C2D1;
}
QPushButton:pressed {
    background: #EBEFF5;
}
QPushButton:focus {
    border-color: #2563EB;
}
QPushButton:disabled {
    background: #F8FAFC;
    border-color: #E3E8EF;
    color: #A0AABB;
}
QPushButton[variant=&quot;primary&quot;] {
    background: #2563EB;
    border-color: #2563EB;
    color: #FFFFFF;
}
QPushButton[variant=&quot;primary&quot;]:hover {
    background: #1D4ED8;
    border-color: #1D4ED8;
}
QPushButton[variant=&quot;primary&quot;]:pressed {
    background: #1E40AF;
    border-color: #1E40AF;
}
QPushButton[variant=&quot;primary&quot;]:focus {
    border-color: #1E3A8A;
}
QPushButton[variant=&quot;primary&quot;]:disabled {
    background: #A9C1F7;
    border-color: #A9C1F7;
    color: #EEF3FF;
}
QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px 8px;
    color: #475569;
}
QToolButton:hover {
    background: #F1F5F9;
    color: #1F2937;
}
QToolButton:pressed {
    background: #E2E8F0;
}
QToolButton#toggleLogButton {
    background: #FFFFFF;
    border-color: #D0D7E2;
    padding: 0px;
}
QToolButton#toggleLogButton:hover {
    background: #F5F7FB;
    border-color: #B8C2D1;
}
QToolButton#toggleLogButton:checked {
    background: #EFF4FF;
    border-color: #C7D7FB;
}

/* ---- Table -------------------------------------------------------- */
QTableWidget {
    background: #FFFFFF;
    alternate-background-color: #FAFBFD;
    border: none;
    color: #1F2937;
    selection-background-color: #DBE7FE;
    selection-color: #0F172A;
    outline: 0px;
}
QTableWidget::item {
    /* Qt adds a 3px text margin: 7+3 and 21+3 line up with the header padding */
    padding: 0px 21px 0px 7px;
    border: none;
    border-bottom: 1px solid #EEF2F6;
}
QTableWidget::item:selected {
    background: #DBE7FE;
    color: #0F172A;
}
QHeaderView {
    background: #F8FAFC;
    border: none;
}
QHeaderView::section {
    background: #F8FAFC;
    color: #64748B;
    font-family: &quot;Segoe UI Semibold&quot;;
    font-size: 12px;
    padding: 9px 24px 9px 10px; /* the right padding holds the sort arrow */
    border: none;
    border-top: 1px solid #EEF2F6;
    border-bottom: 1px solid #E3E8EF;
}
QHeaderView::section:hover {
    background: #F1F5F9;
    color: #334155;
}
QHeaderView::up-arrow {
    image: url(:/icons/arrow-up.svg);
    width: 12px;
    height: 12px;
    subcontrol-origin: padding;
    subcontrol-position: center right;
}
QHeaderView::down-arrow {
    image: url(:/icons/arrow-down.svg);
    width: 12px;
    height: 12px;
    subcontrol-origin: padding;
    subcontrol-position: center right;
}
QTableCornerButton::section {
    background: #F8FAFC;
    border: none;
}

/* ---- Scrollbars --------------------------------------------------- */
QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 2px;
}
QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #CBD5E1;
    min-height: 32px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal {
    background: #CBD5E1;
    min-width: 32px;
    border-radius: 4px;
}
QScrollBar::handle:hover {
    background: #94A3B8;
}
QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0px;
    height: 0px;
    border: none;
    background: none;
}
QScrollBar::add-page,
QScrollBar::sub-page {
    background: none;
}
QAbstractScrollArea::corner {
    background: transparent;
}

/* ---- Splitter between the table and the log ----------------------- */
QSplitter::handle:vertical {
    image: url(:/icons/grip.svg);
}
QSplitter::handle:vertical:hover {
    image: url(:/icons/grip-hover.svg);
}

/* ---- Activity log ------------------------------------------------- */
QPlainTextEdit#logView {
    background: #FFFFFF;
    border: none;
    padding: 4px 8px;
    font-family: &quot;Cascadia Mono&quot;, &quot;Consolas&quot;;
    font-size: 12px;
    color: #334155;
    selection-background-color: #BFD3FD;
    selection-color: #0F172A;
}

/* ---- Action bar --------------------------------------------------- */
QFrame#actionBar {
    background: #FFFFFF;
    border: none;
    border-top: 1px solid #E3E8EF;
}
QFrame[role=&quot;separator&quot;] {
    background: #E3E8EF;
    border: none;
    min-width: 1px;
    max-width: 1px;
    min-height: 22px;
    max-height: 22px;
}
QLabel#statusLabel {
    color: #334155;
}
QLabel#statusDot {
    background: #94A3B8;
    border-radius: 4px;
    min-width: 8px;
    max-width: 8px;
    min-height: 8px;
    max-height: 8px;
}
QLabel#statusDot[state=&quot;busy&quot;] {
    background: #F59E0B;
}
QLabel#statusDot[state=&quot;ok&quot;] {
    background: #16A34A;
}
QLabel#statusDot[state=&quot;error&quot;] {
    background: #DC2626;
}
QProgressBar {
    background: #E8EDF5;
    border: none;
    border-radius: 3px;
    min-height: 6px;
    max-height: 6px;
}
QProgressBar::chunk {
    background: #2563EB;
    border-radius: 3px;
}

/* ---- Menus -------------------------------------------------------- */
QMenu {
    background: #FFFFFF;
    border: 1px solid #E3E8EF;
    padding: 4px;
}
QMenu::item {
    padding: 6px 20px 6px 12px;
    border-radius: 4px;
}
QMenu::item:selected {
    background: #EFF4FF;
    color: #1D4ED8;
}
QMenu::item:disabled {
    color: #A0AABB;
}
QMenu::separator {
    height: 1px;
    background: #EEF2F6;
    margin: 4px 6px;
}

/* ---- Calendar popup of the date fields ---------------------------- */
QCalendarPopup {
    background: #D0D7E2; /* shows as a 1px border around the calendar */
}
QCalendarWidget QWidget#qt_calendar_navigationbar {
    background: #FFFFFF;
}
QCalendarWidget QToolButton {
    color: #1F2937;
    font-family: &quot;Segoe UI Semibold&quot;;
    padding: 4px 8px;
}
QCalendarWidget QToolButton::menu-indicator {
    image: none;
    width: 0px;
}
QCalendarWidget QToolButton#qt_calendar_prevmonth {
    qproperty-icon: url(:/icons/chevron-left.svg);
}
QCalendarWidget QToolButton#qt_calendar_nextmonth {
    qproperty-icon: url(:/icons/chevron-right.svg);
}
QCalendarWidget QSpinBox {
    background: #FFFFFF;
    border: 1px solid #D0D7E2;
    border-radius: 4px;
    padding: 2px 4px;
    selection-background-color: #BFD3FD;
    selection-color: #0F172A;
}
QCalendarWidget QSpinBox::up-button,
QCalendarWidget QSpinBox::down-button {
    width: 0px;
    border: none;
}
QCalendarWidget QAbstractItemView:enabled {
    background: #FFFFFF;
    color: #1F2937;
    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
    outline: 0px;
}
QCalendarWidget QAbstractItemView:disabled {
    color: #CBD5E1;
}
</string>
